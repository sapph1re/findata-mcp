# FinData MCP — Environment Variables
# Copy to .env and fill in values before deploying

# ── x402 Payment Configuration ─────────────────────────────────────────────
# Your wallet address to receive $0.01/call payments
X402_WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS_HERE

# Payment network: eip155:8453 = Base mainnet, eip155:84532 = Base Sepolia (testnet)
X402_NETWORK=eip155:8453

# x402 facilitator URL (default is fine for Base)
X402_FACILITATOR_URL=https://x402.org/facilitator

# Verify payments on-chain (true in production, false for testing)
X402_VERIFY=true

# ── API Keys ────────────────────────────────────────────────────────────────
# FRED API key — get free at https://fred.stlouisfed.org/docs/api/api_key.html
# Without this: 120 req/min. With this: 1000 req/min.
FRED_API_KEY=

# ── Database ────────────────────────────────────────────────────────────────
# Path for the API keys SQLite database (persisted via Docker volume)
FINDATA_DB_PATH=/data/findata.db
